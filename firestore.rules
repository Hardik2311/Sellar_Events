rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // Real super-admin accounts — keep this in sync with SUPER_ADMIN_UIDS in
    // SuperAdminPlanLeads.tsx / SupportAdminSupportTickets.tsx.
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.uid in ['sR4lj7OfkAc7DhdxfHhuC7XAzLC2'];
    }

    function isCompanyMember(companyId) {
      return isAuthenticated() && (request.auth.token.companyId == companyId || request.auth.uid == companyId);
    }

    function isSelf(companyId, userId) {
      return isCompanyMember(companyId) && request.auth.uid == userId;
    }
// NEW — reads this user's role from companies/{companyId}/users/{uid}.role
    // Falls back to 'admin' if the user doc is missing role (matches AuthContext's
    // client-side fallback: userData.role || mergedCompany.role || 'admin').
    function userRole(companyId) {
      let userDoc = get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid));
      return userDoc.data.role != null ? userDoc.data.role : 'admin';
    }

       function isOwner(companyId) {
      return isCompanyMember(companyId) && userRole(companyId) == 'admin';
    }

    // NEW — checks a named flag (e.g. 'deleteEvent') for the caller's role inside
    // companies/{companyId}/settings/permissions. Owner bypasses this entirely.
    function hasPermission(companyId, permKey) {
      let role = userRole(companyId);
      return isOwner(companyId) ||
        (
          isCompanyMember(companyId) &&
          exists(/databases/$(database)/documents/companies/$(companyId)/settings/permissions) &&
          get(/databases/$(database)/documents/companies/$(companyId)/settings/permissions).data[role][permKey] == true
        );
    }

    // NEW — event-credit guard: client can ONLY ever decrement eventCredits
    // by exactly 1, and only if they're allowed to create an event. Any other
    // change to this field (increase, jump, decrement>1) is rejected.
    // Recharging (increasing credits) must happen via Admin SDK / backend,
    // which bypasses these rules entirely.
    function isValidEventCreditsUpdate(companyId) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let currentCredits = ('eventCredits' in resource.data) ? resource.data.eventCredits : 0;
      return !affected.hasAny(['eventCredits']) ||
        (
          affected.hasOnly(['eventCredits']) &&
          currentCredits > 0 &&
          request.resource.data.eventCredits == currentCredits - 1 &&
          (hasPermission(companyId, 'publishEvent') || hasPermission(companyId, 'saveDraftEvent'))
        );
    }

       // --- Support Tickets (raised from SupportPage) ---
    // Any authenticated organizer can create a ticket for themselves.
    // Read/update is open to any authenticated user for now — the actual
    // Super Admin gating happens client-side via SUPER_ADMIN_UIDS.
    // TODO: once SUPER_ADMIN_UIDS is finalized, tighten update/delete to those UIDs only.
    match /event_support_tickets/{ticketId} {
      allow create: if isAuthenticated();
      allow read, update: if isAuthenticated();
      allow delete: if false;
    }

    // --- Plan Leads (from Recharge page, wired later with payment gateway) ---
    match /event_plan_leads/{leadId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated();
    }

    // --- Auto-increment counters (e.g. ticket reference numbers) ---
    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    function isSuperAdminCreditTopUp(companyId) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let currentCredits = ('eventCredits' in resource.data) ? resource.data.eventCredits : 0;
      return affected.hasOnly(['eventCredits']) &&
        request.resource.data.eventCredits is number &&
        request.resource.data.eventCredits > currentCredits;
    }

    // --- Tenant Data (Sellar Events) ---
    match /companies/{companyId} {

      // Company document
      allow read: if true;
      allow update: if (isCompanyMember(companyId) && isValidEventCreditsUpdate(companyId))
        || (isSuperAdmin() && isSuperAdminCreditTopUp(companyId));

      // Business Info (Organization name, website, branding)
      match /business_info/{docId} {
        allow read: if true;
        allow write: if isCompanyMember(companyId);
      }
      match /businessinfo/{docId} {
        allow read: if true;
        allow write: if isCompanyMember(companyId);
      }

      // Users / Organizer Profiles
      match /users/{userId} {
        allow read: if isCompanyMember(companyId) || isSuperAdmin();
        allow create, update: if isCompanyMember(companyId) || isSelf(companyId, userId);
        allow delete: if false;
      }
 // NEW — Permissions doc: everyone in the company can read it (needed to
      // evaluate their own access client-side), only the owner can write it.
      match /settings/permissions {
        allow read: if isCompanyMember(companyId);
        allow write: if isOwner(companyId);
      }
      // Events Collection — CHANGED: split write into create/update/delete,
      // each gated by its matching permission flag
      match /events/{eventId} {
        // Public can discover & view events
        allow read: if true;
        allow create: if hasPermission(companyId, 'publishEvent') || hasPermission(companyId, 'saveDraftEvent');
        allow update: if hasPermission(companyId, 'editEvent')
          || hasPermission(companyId, 'toggleEventLive')
          || hasPermission(companyId, 'toggleEventFeatured')
          || hasPermission(companyId, 'duplicateEvent');
        allow delete: if hasPermission(companyId, 'deleteEvent');

        // Attendees (Guest List & Real-time Check-ins) — CHANGED
        match /attendees/{attendeeId} {
          allow read: if isCompanyMember(companyId);
          allow update: if hasPermission(companyId, 'checkInAttendee') || hasPermission(companyId, 'cancelAttendee');
          allow create, delete: if isOwner(companyId);
        }

        // Expenses (Event budgeting/expenses) — CHANGED
        match /expenses/{expenseId} {
          allow read: if isCompanyMember(companyId);
          allow write: if hasPermission(companyId, 'addExpense');
        }

        // Incomes (Event sponsorship/other income) — NEW
        match /incomes/{incomeId} {
          allow read: if isCompanyMember(companyId);
          allow write: if hasPermission(companyId, 'addIncome');
        }
      }

      // Catch-all for any other company subcollections
      match /{collection}/{docId} {
        allow read, write: if isCompanyMember(companyId);
      }
    }
  }
}