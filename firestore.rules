rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // Real super-admin accounts — keep this in sync with SUPER_ADMIN_UIDS in
    // SuperAdminPlanLeads.tsx / SupportAdminSupportTickets.tsx.
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.uid in ['sR4lj7OfkAc7DhdxfHhuC7XAzLC2'];
    }

    function isCompanyMember(companyId) {
      return isAuthenticated() && (request.auth.token.companyId == companyId || request.auth.uid == companyId);
    }

    function isSelf(companyId, userId) {
      return isCompanyMember(companyId) && request.auth.uid == userId;
    }
// NEW — reads this user's role from companies/{companyId}/users/{uid}.role
    // Falls back to 'admin' if the user doc is missing role (matches AuthContext's
    // client-side fallback: userData.role || mergedCompany.role || 'admin').
    function userRole(companyId) {
      let userDoc = get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid));
      return userDoc.data.role != null ? userDoc.data.role : 'admin';
    }

       function isOwner(companyId) {
      return isCompanyMember(companyId) && userRole(companyId) == 'admin';
    }

    // Mirrors DEFAULT_PERMISSIONS in src/types/permissions.types.ts — used
    // below ONLY as a fallback when the owner has never opened Settings ->
    // Permissions and saved (so companies/{companyId}/settings/permissions
    // doesn't exist yet, or is missing this role/key). Without this fallback,
    // the client UI shows these actions as allowed (it has its own copy of
    // these same defaults) but every write silently failed here instead —
    // this keeps the two in sync.
    function defaultPermission(role, permKey) {
      return
        (role == 'team_leader' && permKey in [
          'viewDashboard', 'toggleSensitiveData', 'viewCreateEvent', 'publishEvent', 'saveDraftEvent',
          'viewMyEvents', 'editEvent', 'duplicateEvent', 'toggleEventLive', 'toggleEventFeatured',
          'viewAttendees', 'checkInAttendee', 'cancelAttendee', 'exportAttendees', 'scanQr',
          'addWalkInAttendee', 'import_attendees', 'editAttendee', 'viewReports', 'addExpense',
          'viewSettings', 'editEventSettings', 'editCompanySettings', 'editAppSettings', 'addIncome'
        ]) ||
        (role == 'team' && permKey in [
          'viewDashboard', 'viewAttendees', 'checkInAttendee', 'scanQr', 'addWalkInAttendee',
          'viewSettings', 'editAppSettings', 'addExpense', 'editAttendee', 'viewMyEvents'
        ]);
    }

    // NEW — checks a named flag (e.g. 'deleteEvent') for the caller's role inside
    // companies/{companyId}/settings/permissions. Owner bypasses this entirely.
    function hasPermission(companyId, permKey) {
      let role = userRole(companyId);
      let permsPath = /databases/$(database)/documents/companies/$(companyId)/settings/permissions;
      return isOwner(companyId) ||
        (
          isCompanyMember(companyId) &&
          (
            (exists(permsPath) && role in get(permsPath).data && permKey in get(permsPath).data[role])
              ? get(permsPath).data[role][permKey] == true
              : defaultPermission(role, permKey)
          )
        );
    }

        // NEW — allows ANY company member (regardless of role/permissions) to
    // hard-delete an event doc once it's been sitting soft-deleted for 30+
    // days. This is intentionally not gated by 'deleteEvent' permission —
    // the delete decision was already made when the event was soft-deleted;
    // this just lets whoever's dashboard happens to load next (lazy cleanup,
    // no server cron) finish the job, no matter which role they have.
    function isEligibleForHardDelete(companyId) {
      return isCompanyMember(companyId) &&
        resource.data.status == 'deleted' &&
        resource.data.deletedAt != null &&
        request.time > resource.data.deletedAt + duration.value(30, 'd');
    }

    // NEW — event-credit guard: client can ONLY ever decrement eventCredits
    // by exactly 1, and only if they're allowed to create an event. Any other
    // change to this field (increase, jump, decrement>1) is rejected.
    // Recharging (increasing credits) must happen via Admin SDK / backend,
    // which bypasses these rules entirely.
    function isValidEventCreditsUpdate(companyId) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let currentCredits = ('eventCredits' in resource.data) ? resource.data.eventCredits : 0;
      return !affected.hasAny(['eventCredits']) ||
        (
          affected.hasOnly(['eventCredits']) &&
          currentCredits > 0 &&
          request.resource.data.eventCredits == currentCredits - 1 &&
          (hasPermission(companyId, 'publishEvent') || hasPermission(companyId, 'saveDraftEvent'))
        );
    }

       // --- Support Tickets (raised from SupportPage) ---
    // Any authenticated organizer can create a ticket for themselves.
    // Read/update is open to any authenticated user for now — the actual
    // Super Admin gating happens client-side via SUPER_ADMIN_UIDS.
    // TODO: once SUPER_ADMIN_UIDS is finalized, tighten update/delete to those UIDs only.
    match /event_support_tickets/{ticketId} {
      allow create: if isAuthenticated();
      allow read, update: if isAuthenticated();
      allow delete: if false;
    }

    // --- Plan Leads (from Recharge page, wired later with payment gateway) ---
    match /event_plan_leads/{leadId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated();
    }

    // --- Auto-increment counters (e.g. ticket reference numbers) ---
    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // Lets a super admin add OR remove credits (Manage Credits page) — only
    // the eventCredits field may change, and it can never go negative.
    function isSuperAdminCreditChange(companyId) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['eventCredits']) &&
        request.resource.data.eventCredits is number &&
        request.resource.data.eventCredits >= 0;
    }

    // --- Tenant Data (Sellar Events) ---
    match /companies/{companyId} {

      // Company document
      allow read: if true;
      // The public event-link (subdomain/domainAliases) is owner-only to
      // change — any other company member editing it would silently hijack
      // the org's public URL. All other non-credit fields stay open to any
      // company member, matching isValidEventCreditsUpdate's existing scope.
      allow update: if (
          isCompanyMember(companyId) &&
          isValidEventCreditsUpdate(companyId) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subdomain', 'domainAliases'])
            || isOwner(companyId)
          )
        )
        || (isSuperAdmin() && isSuperAdminCreditChange(companyId));

      // Business Info (Organization name, website, branding)
      match /business_info/{docId} {
        allow read: if true;
        allow write: if isCompanyMember(companyId);
      }
      match /businessinfo/{docId} {
        allow read: if true;
        allow write: if isCompanyMember(companyId);
      }

      // Users / Organizer Profiles
      match /users/{userId} {
        allow read: if isCompanyMember(companyId) || isSuperAdmin();
        allow create, update: if isCompanyMember(companyId) || isSelf(companyId, userId);
        allow delete: if false;
      }
 // NEW — Permissions doc: everyone in the company can read it (needed to
      // evaluate their own access client-side), only the owner can write it.
      match /settings/permissions {
        allow read: if isCompanyMember(companyId);
        allow write: if isOwner(companyId);
      }
      // General settings (ticket display, tax, branding, etc.) — read
      // publicly, since useCompanySettings() is used on the public storefront
      // (subdomain) to render event cards, not just inside the organizer app.
      match /settings/general {
        allow read: if true;
        allow write: if isCompanyMember(companyId);
      }
      // Events Collection — CHANGED: split write into create/update/delete,
      // each gated by its matching permission flag
      match /events/{eventId} {
        // Public can discover & view events
        allow read: if true;
        allow create: if hasPermission(companyId, 'publishEvent') || hasPermission(companyId, 'saveDraftEvent');
        // Public ticket purchase (Checkout.tsx / ManualQRPaymentCard.tsx) also
        // updates tiers[].sold and, for a private-event access code, marks
        // that code consumed in accessCodes[] — same transaction, same write.
        // Best-effort validation only: Firestore rules can't loop over either
        // array to check each element (tier price/quantity/sold, or a code's
        // usedAt/usedCount) individually, so this only blocks resizing the
        // arrays (adding/removing tiers or codes). A determined client could
        // still tamper with values inside existing elements. Move this
        // server-side (Cloud Function) before real payments go live.
        allow update: if hasPermission(companyId, 'editEvent')
          || hasPermission(companyId, 'toggleEventLive')
          || hasPermission(companyId, 'toggleEventFeatured')
          || hasPermission(companyId, 'duplicateEvent')
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tiers', 'accessCodes']) &&
            request.resource.data.tiers.size() == resource.data.tiers.size() &&
            (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accessCodes']) ||
              request.resource.data.accessCodes.size() == resource.data.accessCodes.size()
            )
          );
                allow delete: if hasPermission(companyId, 'deleteEvent') || isEligibleForHardDelete(companyId);

        // Attendees (Guest List & Real-time Check-ins) — CHANGED
        match /attendees/{attendeeId} {
          allow read: if isCompanyMember(companyId);
          allow update: if hasPermission(companyId, 'checkInAttendee') || hasPermission(companyId, 'cancelAttendee');
          allow delete: if isOwner(companyId);
          // Public ticket purchase (Checkout.tsx / ManualQRPaymentCard.tsx)
          // creates the attendee/ticket record directly — Firestore Rules
          // has no way to loop over the parent event's tiers array to check
          // ticketTierId/price against a real tier (no list comprehension
          // support), so this only does basic type/status checks on the new
          // doc itself. It cannot catch a fabricated tierId or wrong amount.
          // Move this server-side (Cloud Function) before real payments go
          // live — see update-rule comment above re: the same limitation.
          allow create: if isOwner(companyId) || (
            request.resource.data.status == 'valid' &&
            request.resource.data.checkedInAt == null &&
            request.resource.data.amountPaid is number && request.resource.data.amountPaid >= 0 &&
            request.resource.data.ticketId is string &&
            request.resource.data.ticketTierId is string
          );
        }

        // Expenses (Event budgeting/expenses) — CHANGED
        match /expenses/{expenseId} {
          allow read: if isCompanyMember(companyId);
          allow write: if hasPermission(companyId, 'addExpense');
        }

        // Incomes (Event sponsorship/other income) — NEW
        match /incomes/{incomeId} {
          allow read: if isCompanyMember(companyId);
          allow write: if hasPermission(companyId, 'addIncome');
        }
      }

      // Catch-all for any other company subcollections
      match /{collection}/{docId} {
        allow read, write: if isCompanyMember(companyId);
      }
    }
  }
}