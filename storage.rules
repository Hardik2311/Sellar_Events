rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /companies/{companyId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.companyId == companyId;
      allow write: if request.auth != null && request.auth.token.companyId == companyId;
    }
  }
}